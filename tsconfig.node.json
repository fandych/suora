{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "paths": {
      "@electron/*": [
        "./electron/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
  },
  "include": ["electron.vite.config.ts", "electron/**/*.ts", "shared/**/*.ts"]
}