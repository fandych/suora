{
  "name": "suora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./out/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "postinstall": "node scripts/ensure-electron-dist.mjs",
    "electron:download": "node scripts/ensure-electron-dist.mjs --strict",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "dev:root": "NO_SANDBOX=1 electron-vite dev",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.74",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.3.0",
    "@tiptap/extension-image": "^3.30.6",
    "@tiptap/extension-placeholder": "^3.30.6",
    "@tiptap/extension-table": "^3.30.6",
    "@tiptap/extension-table-cell": "^3.30.6",
    "@tiptap/extension-table-header": "^3.30.6",
    "@tiptap/extension-table-row": "^3.30.6",
    "@tiptap/extension-task-item": "^3.30.6",
    "@tiptap/extension-task-list": "^3.30.6",
    "@tiptap/react": "^3.30.6",
    "@tiptap/starter-kit": "^3.30.6",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.11.5",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lucide-react": "^1.37.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "simple-icons": "^16.29.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.suora.app",
    "productName": "SUORA",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "icon": "resources/icons/icon-1024x1024.png",
    "publish": {
      "provider": "github",
      "owner": "fandych",
      "repo": "suora"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  }
}
